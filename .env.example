# Copy this file to .env and fill in your project's values.
# Dashboard → Project Settings → API. The anon key is public by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only used by scripts (security suite + backups) — never shipped to browsers.
TEACHER_EMAIL=you@school.edu
TEACHER_PASSWORD=your-teacher-password
